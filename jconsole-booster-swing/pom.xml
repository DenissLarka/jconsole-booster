<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.druvu</groupId>
		<artifactId>jconsole-booster-parent</artifactId>
		<version>1.2.0-SNAPSHOT</version>
	</parent>

	<artifactId>jconsole-booster-swing</artifactId>

	<name>DRUVU.COM / JCONSOLE BOOSTER / SWING</name>
	<description>The Swing user interface of JConsole Booster 1.1, kept runnable as the reference while the JavaFX interface replaces it; never published.</description>

	<properties>
		<maven.deploy.skip>true</maven.deploy.skip>
		<!-- The Swing front is being replaced by the JavaFX app; the static-analysis gates cover the modules that stay. -->
		<spotbugs.skip>true</spotbugs.skip>
		<pmd.skip>true</pmd.skip>
		<cpd.skip>true</cpd.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- the console flag hands over to the console mode -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-console</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.beryx</groupId>
			<artifactId>awt-color-factory</artifactId>
		</dependency>

		<!-- the JMXMP protocol, found by the core at run time -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-protocol-jmxmp</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Logging: the API only; whoever runs the app picks the binding (the installers use logback). -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<!-- a binding for runs from source; optional, so it reaches no consumer -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<!-- The UI from source (Start-JConsole.ps1). Against the sample target: localhost:7091 as
					     admin/admin, and trust its self-signed certificate once. -->
					<execution>
						<id>start</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>false</skip>
							<executable>java</executable>
							<arguments>
								<argument>--module-path</argument>
								<modulepath/>
								<argument>-m</argument>
								<argument>com.druvu.jconsole/com.druvu.jconsole.launcher.Main</argument>
								<argument>-c=#8BC6E1FF</argument>
								<argument>-debug</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Start-JConsole.ps1 <target>: the connect dialog comes up pre-filled with the target. -->
		<profile>
			<id>jconsole-with-target</id>
			<activation>
				<property>
					<name>jconsole.target</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>start</id>
								<configuration>
									<arguments combine.children="append">
										<argument>${jconsole.target}</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>

</project>
