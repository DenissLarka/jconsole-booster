<?xml version="1.0" encoding="UTF-8"?>
<!-- The child.*.inherit.append.path attributes keep the inherited url and scm pointing at the repository itself. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.druvu</groupId>
	<artifactId>jconsole-booster-parent</artifactId>
	<version>1.2.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>DRUVU.COM / JCONSOLE BOOSTER</name>
	<description>JConsole Booster: a maintained JConsole fork for JVM operations, with markup-driven operation widgets, connection bookmarks, adaptive TLS and a console mode.</description>
	<url>https://github.com/DenissLarka/jconsole-booster</url>

	<modules>
		<module>jconsole-booster-core</module>
		<module>jconsole-booster-protocol-jmxmp</module>
		<module>jconsole-booster-console</module>
		<module>jconsole-booster-sample-target</module>
		<module>jconsole-booster-swing</module>
	</modules>

	<licenses>
		<license>
			<name>GNU General Public License, Version 2 with the Classpath Exception</name>
			<url>https://openjdk.org/legal/gplv2+ce.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Deniss LARKA</name>
			<email>deniss.larka@gmail.com</email>
		</developer>
	</developers>

	<scm child.scm.connection.inherit.append.path="false"
		 child.scm.developerConnection.inherit.append.path="false"
		 child.scm.url.inherit.append.path="false">
		<url>https://github.com/DenissLarka/jconsole-booster</url>
		<connection>scm:git:https://github.com/DenissLarka/jconsole-booster</connection>
		<developerConnection>scm:git:https://github.com/DenissLarka/jconsole-booster</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/DenissLarka/jconsole-booster/</url>
		</repository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>25</java.version>

		<druvu-lib-jmxmp.version>2.0.0</druvu-lib-jmxmp.version>
		<druvu-lib-loader.version>1.1.2</druvu-lib-loader.version>
		<awt-color-factory.version>1.0.2</awt-color-factory.version>
		<lombok.version>1.18.48</lombok.version>
		<slf4j.version>2.0.20</slf4j.version>
		<testng.version>7.12.0</testng.version>
		<assertj.version>3.27.7</assertj.version>

		<!-- plugins -->
		<maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
		<maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
		<maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
		<maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
		<exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
		<maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
		<spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
		<palantir-java-format.version>2.90.0</palantir-java-format.version>
		<spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.druvu</groupId>
				<artifactId>druvu-lib-jmxmp-common</artifactId>
				<version>${druvu-lib-jmxmp.version}</version>
			</dependency>
			<dependency>
				<groupId>com.druvu</groupId>
				<artifactId>druvu-lib-jmxmp-client</artifactId>
				<version>${druvu-lib-jmxmp.version}</version>
			</dependency>
			<dependency>
				<groupId>com.druvu</groupId>
				<artifactId>druvu-lib-jmxmp-server</artifactId>
				<version>${druvu-lib-jmxmp.version}</version>
			</dependency>
			<dependency>
				<groupId>com.druvu</groupId>
				<artifactId>druvu-lib-loader</artifactId>
				<version>${druvu-lib-loader.version}</version>
			</dependency>
			<dependency>
				<groupId>org.beryx</groupId>
				<artifactId>awt-color-factory</artifactId>
				<version>${awt-color-factory.version}</version>
			</dependency>
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
			</dependency>
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>${slf4j.version}</version>
			</dependency>
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-simple</artifactId>
				<version>${slf4j.version}</version>
			</dependency>
			<dependency>
				<groupId>org.testng</groupId>
				<artifactId>testng</artifactId>
				<version>${testng.version}</version>
				<exclusions>
					<exclusion>
						<groupId>org.slf4j</groupId>
						<artifactId>slf4j-api</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
			<dependency>
				<groupId>org.assertj</groupId>
				<artifactId>assertj-core</artifactId>
				<version>${assertj.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<release>${java.version}</release>
						<encoding>UTF-8</encoding>
						<debug>true</debug>
						<showDeprecation>true</showDeprecation>
						<showWarnings>true</showWarnings>
						<optimize>true</optimize>
						<fork>true</fork>
						<compilerArgs>
							<arg>--module-version=${project.version}</arg>
							<arg>-parameters</arg>
						</compilerArgs>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
					<configuration>
						<useModulePath>false</useModulePath>
						<properties>
							<property>
								<name>usedefaultlisteners</name>
								<value>false</value>
							</property>
						</properties>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven-jar-plugin.version}</version>
					<configuration>
						<archive>
							<manifest>
								<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
								<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
							</manifest>
						</archive>
					</configuration>
				</plugin>

				<!-- Skipped unless a module's execution says otherwise, so `mvn -pl <module> -am compile exec:exec@<id>`
				     runs the program in that module only. The plugin checks the executable before the skip flag,
				     hence the executable here. -->
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>${exec-maven-plugin.version}</version>
					<configuration>
						<skip>true</skip>
						<executable>java</executable>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-shade-plugin</artifactId>
					<version>${maven-shade-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.version}</version>
				<executions>
					<execution>
						<id>enforce-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<banDuplicatePomDependencyVersions/>
								<reactorModuleConvergence/>
								<dependencyConvergence/>
								<requireJavaVersion>
									<version>[${java.version},26)</version>
									<message>JConsole Booster builds on JDK ${java.version}: the formatter does not run on newer JDKs.</message>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
							<style>PALANTIR</style>
							<formatJavadoc>true</formatJavadoc>
						</palantirJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>verify</phase>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs-maven-plugin.version}</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<xmlOutput>true</xmlOutput>
					<includeTests>true</includeTests>
					<excludeFilterFile>${project.basedir}/_spotbug-filters/spotbug-exclude.xml</excludeFilterFile>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${maven-pmd-plugin.version}</version>
				<configuration>
					<printFailingErrors>true</printFailingErrors>
					<failurePriority>3</failurePriority>
					<includeTests>true</includeTests>
					<linkXRef>false</linkXRef>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
							<goal>cpd-check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
