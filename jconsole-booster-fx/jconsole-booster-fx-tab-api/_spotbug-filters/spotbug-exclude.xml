<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- The context hands every tab the same live connection and the app's services; a copy of either cannot exist. -->
    <Match>
        <Class name="com.druvu.jconsole.fx.tab.TabContext"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
