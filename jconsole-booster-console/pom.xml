<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.druvu</groupId>
		<artifactId>jconsole-booster-parent</artifactId>
		<version>1.2.0-SNAPSHOT</version>
	</parent>

	<artifactId>jconsole-booster-console</artifactId>

	<name>DRUVU.COM / JCONSOLE BOOSTER / CONSOLE</name>
	<description>The console mode of JConsole Booster: a text REPL that connects over JMXMP or RMI, browses MBeans, invokes operations and writes thread dumps, for a terminal or a bastion without a display; also the plain jar for any full JDK 25+.</description>

	<dependencies>
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- the JMXMP protocol, found by the core at run time -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-protocol-jmxmp</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!-- a binding for the plain jar and runs from source; optional, so it reaches no consumer -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- the in-process targets of the end-to-end tests -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>druvu-lib-jmxmp-server</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!-- `mvn -Puberjar package`: one plain (non-JPMS) executable jar for `java -jar` on a full JDK 25+, to copy onto
		     a server or bastion. module-info is left out (classpath delivery), so the JMXMP transport and connector are
		     found through META-INF/services: the ServicesResourceTransformer is load-bearing. -->
		<profile>
			<id>uberjar</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>uberjar</id>
								<phase>package</phase>
								<goals>
									<goal>shade</goal>
								</goals>
								<configuration>
									<outputFile>${project.build.directory}/dist/jconsole-booster.jar</outputFile>
									<createDependencyReducedPom>false</createDependencyReducedPom>
									<filters>
										<filter>
											<artifact>*:*</artifact>
											<excludes>
												<exclude>module-info.class</exclude>
												<exclude>META-INF/versions/*/module-info.class</exclude>
												<exclude>META-INF/*.SF</exclude>
												<exclude>META-INF/*.DSA</exclude>
												<exclude>META-INF/*.RSA</exclude>
											</excludes>
										</filter>
									</filters>
									<transformers>
										<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
											<manifestEntries>
												<Main-Class>com.druvu.jconsole.console.ConsoleMain</Main-Class>
											</manifestEntries>
										</transformer>
										<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
									</transformers>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
