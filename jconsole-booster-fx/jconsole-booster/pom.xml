<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.druvu</groupId>
		<artifactId>jconsole-booster-fx</artifactId>
		<version>1.2.0-SNAPSHOT</version>
	</parent>

	<artifactId>jconsole-booster</artifactId>
	<name>DRUVU.COM / JCONSOLE BOOSTER / APP</name>
	<description>JConsole Booster, the JavaFX app: one window on one JVM connection, the connect and certificate dialogs, bookmarks, the tabs found at run time, and the console mode handed over to the console module.</description>

	<dependencies>
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-fx-tab-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-console</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>druvu-lib-fx</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<!-- found at run time through druvu-lib-loader -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-protocol-jmxmp</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-fx-tab-summary</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>jconsole-booster-fx-tab-mbeans</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
